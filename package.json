{
  "name": "newsela-lessons",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @nl/db generate",
    "db:migrate": "pnpm --filter @nl/db migrate",
    "db:seed": "pnpm --filter @nl/db seed"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@node-rs/argon2",
      "sharp",
      "unrs-resolver"
    ]
  }
}
