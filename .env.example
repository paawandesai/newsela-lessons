# Copy to .env at the repo root. `pnpm dev`, `pnpm db:*` and the load scripts read it. Never commit real values.
DATABASE_URL=postgres://nl:nl@localhost:5432/newsela_lessons
REDIS_URL=redis://localhost:6379
# Database connections per process.
DB_POOL_MAX=10
# Anthropic API key (an organization API key, never a consumer account).
# ANTHROPIC_NEWSELA_API_KEY is read as a fallback name for the same key.
ANTHROPIC_API_KEY=
ANTHROPIC_NEWSELA_API_KEY=
# Model id is configuration, not code.
GENERATION_MODEL=claude-opus-5-5
# Optional: Anthropic API base URL (default https://api.anthropic.com).
GENERATION_API_BASE_URL=
# Spend cap per unit, in USD, across all runs, regenerations and AI suggestions.
UNIT_SPEND_CAP_USD=25
# Spend cap across all units per UTC day, in USD.
DAILY_SPEND_CAP_USD=100
# Worker tuning: lessons generated in parallel, and the output token limit per request.
GENERATION_CONCURRENCY=3
GENERATION_MAX_TOKENS=32000
# Local development only: 1 writes placeholder lessons and suggestions instead of calling the API.
GENERATION_FAKE=0
# Signs session cookies and collaboration tokens. 32+ characters, e.g. `openssl rand -hex 32`.
AUTH_SECRET=
# Collaboration server port, and its URL as the browser sees it (baked into the web build).
COLLAB_PORT=1234
NEXT_PUBLIC_COLLAB_URL=ws://localhost:1234
# Password for the three demo accounts created by `pnpm db:seed`.
SEED_PASSWORD=
# Docker Compose and deployment only: Postgres password and Caddy's public hostname.
POSTGRES_PASSWORD=
SITE_ADDRESS=
