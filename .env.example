# Copy to .env. Never commit real values.
DATABASE_URL=postgres://nl:nl@localhost:5432/newsela_lessons
REDIS_URL=redis://localhost:6379
ANTHROPIC_API_KEY=
# Model id is configuration, not code.
GENERATION_MODEL=claude-opus-5-5
# Default spend cap per unit generation run, in USD.
UNIT_SPEND_CAP_USD=25
# Signs session cookies and collaboration tokens. Use a long random string.
AUTH_SECRET=
# Public URL of the collaboration server, as the browser sees it.
NEXT_PUBLIC_COLLAB_URL=ws://localhost:1234
